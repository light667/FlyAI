# ─── Secrets — never commit ────────────────────────────────────────────────────
**/.env
**/.env.local
**/.env.production
**/.env.development

# Keep example files
!**/.env.example

# ─── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/
*.log

# ─── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# ─── Docker ────────────────────────────────────────────────────────────────────
*.dockerignore

# ─── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ───────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
.zcode
