{
  "builds": [
    {
      "src": "frontend/next.config.ts",
      "use": "@vercel/next"
    },
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/backend/:path*",
      "destination": "backend/api/index.py"
    },
    {
      "source": "/logo.png",
      "destination": "frontend/public/logo.png"
    },
    {
      "source": "/icon.png",
      "destination": "frontend/src/app/icon.png"
    },
    {
      "source": "/favicon.ico",
      "destination": "frontend/public/logo.png"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/$1"
    }
  ]
}
